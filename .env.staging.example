# Copy to .env.staging locally and fill from the VOWVY Staging web-app settings.
# Never reuse production values in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vowvy-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vowvy-staging
VITE_FIREBASE_STORAGE_BUCKET=vowvy-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_APP_BASE_URL=https://vowvy-staging.web.app

# App Check is intentionally disabled in staging unless a staging-only key is set.
VITE_APPCHECK_SITE_KEY=
