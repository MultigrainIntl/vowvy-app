{
  "name": "vowvy-functions",
  "description": "Cloud Functions for vowvy",
  "scripts": {
    "build": "tsc",
    "test:emulator": "npm run build && node --test test/moveCollaboratorPhoto.test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "private": true
}
