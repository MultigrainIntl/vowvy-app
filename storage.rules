rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owns(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    function hasPhotoAccess(ownerUid) {
      return request.auth != null
        && request.auth.uid != ownerUid
        && firestore.exists(/databases/(default)/documents/users/$(ownerUid)/collaboratorAccess/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(ownerUid)/collaboratorAccess/$(request.auth.uid)).data.schemaVersion == 1
        && firestore.get(/databases/(default)/documents/users/$(ownerUid)/collaboratorAccess/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(ownerUid)/collaboratorAccess/$(request.auth.uid)).data.validFromMs <= request.time.toMillis()
        && (firestore.get(/databases/(default)/documents/users/$(ownerUid)/collaboratorAccess/$(request.auth.uid)).data.expiresAtMs == null
          || request.time.toMillis() < firestore.get(/databases/(default)/documents/users/$(ownerUid)/collaboratorAccess/$(request.auth.uid)).data.expiresAtMs)
        && 'photo.create' in firestore.get(/databases/(default)/documents/users/$(ownerUid)/collaboratorAccess/$(request.auth.uid)).data.capabilities;
    }

    match /users/{ownerUid}/containers/{containerId}/photos/{fileName} {
      allow read: if owns(ownerUid)
        || (hasPhotoAccess(ownerUid)
          && firestore.get(/databases/(default)/documents/users/$(ownerUid)/containers/$(containerId)).data.effectiveIsPrivate == false
          && firestore.get(/databases/(default)/documents/users/$(ownerUid)/containers/$(containerId)).data.deletedAt == null);
      allow create: if owns(ownerUid)
        || (hasPhotoAccess(ownerUid)
          && firestore.get(/databases/(default)/documents/users/$(ownerUid)/containers/$(containerId)).data.effectiveIsPrivate == false
          && firestore.get(/databases/(default)/documents/users/$(ownerUid)/containers/$(containerId)).data.deletedAt == null
          && request.resource.size < 20 * 1024 * 1024
          && request.resource.contentType.matches('image/.*'));
      allow update, delete: if owns(ownerUid);
    }

    match /users/{ownerUid}/{allPaths=**} {
      allow read, write: if owns(ownerUid);
    }
  }
}
